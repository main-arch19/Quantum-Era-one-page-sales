# Copy to .env.local and fill in. Nothing here is committed.

# ── Lead delivery ────────────────────────────────────────────────────────────
# Without RESEND_API_KEY the gate still works and the lead is logged to the
# server console rather than lost — but nothing reaches your inbox.
RESEND_API_KEY=
LEAD_TO_EMAIL=main@quantumerasolutions.com
# Must be a domain you have verified in Resend.
LEAD_FROM_EMAIL=leads@quantumerasolutions.com

# ── Storage ──────────────────────────────────────────────────────────────────
# Shared with the internal CRM, which owns the schema. supabase/schema.sql here
# created the original single table; supabase/crm-migration.sql in the QESCRM
# repo turns it into the CRM schema. Run them in that order on a fresh project.
#
# The SERVICE ROLE key bypasses row-level security, so it is server-only and
# must never be prefixed NEXT_PUBLIC_. lib/supabase.ts imports "server-only" to
# make that mistake a build error rather than a breach.
#
# Unset, the page still works: the form captures and emails the lead, and only
# the booked_at follow-up segment is lost.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The row level security tests live in the CRM repo, not here — this app only
# ever talks to Supabase as the service role, which bypasses RLS entirely.
# Run them there after any policy change:  npm run test:rls

# ── The audit ────────────────────────────────────────────────────────────────
# Google PageSpeed Insights. Free key from the Google Cloud console with the
# "PageSpeed Insights API" enabled.
#
# Unset, the mobile-speed check reports "not run" and every other check is
# unaffected. It never invents a score.
PAGESPEED_API_KEY=

# ── Scheduling ───────────────────────────────────────────────────────────────
# The Calendly event link for the free teardown. Inline on /booked only.
# Requires Calendly STANDARD ($12/mo) — the free plan has no webhooks and
# cannot remove Calendly's own branding from the booking widget.
NEXT_PUBLIC_CALENDLY_URL=

# Returned once when you create the webhook subscription via the Calendly API
# (see README). Without it the webhook route rejects everything with a 503,
# which is deliberate — an unauthenticated endpoint that writes to your
# database is worse than no endpoint.
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── Tracking ─────────────────────────────────────────────────────────────────
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Google Ads conversion ID, e.g. AW-123456789
NEXT_PUBLIC_ADS_CONVERSION_ID=
# The conversion action's label, e.g. AbC-D_efG12hIjKlMn
NEXT_PUBLIC_ADS_CONVERSION_LABEL=
